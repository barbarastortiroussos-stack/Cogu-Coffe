/* Reseta margens padrão */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #1e1e24;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Placar de topo */
#placar {
    width: 800px;
    background-color: #3a2e2b;
    color: #fff;
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 12px 12px 0 0;
    border: 3px solid #5a4338;
    border-bottom: none;
}

#btn-pause {
    background-color: #e76f51;
    color: white;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
}

/* Onde a imagem do cenário é aplicada */
#cenario {
    width: 800px;
    height: 500px;
    background-image: url('assets/cafe-bg.jpg'); /* Sua imagem do cenário aqui */
    background-size: cover;
    background-position: center;
    position: relative;
    border: 3px solid #5a4338;
    border-radius: 0 0 12px 12px;
    overflow: hidden;
}

/* Área do cliente e balão de fala */
#area-cliente {
    position: absolute;
    top: 120px;
    left: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#sprite-cliente {
    width: 120px;
    height: auto;
}

#balao-pedido {
    background-color: white;
    padding: 8px 14px;
    border-radius: 15px;
    border: 2px solid #333;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: bold;
}

/* Balcão com botões de itens */
#balcao {
    position: absolute;
    bottom: 30px;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 20px;
}

.btn-item {
    background-color: #f4a261;
    border: 2px solid #e76f51;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.1s;
}

.btn-item:hover {
    transform: scale(1.05);
}

/* Modal da Lojinha escondido por padrão */
.escondido {
    display: none;
}
